PORT=3001
NODE_ENV=development

# Core
MONGO_URI=mongodb://127.0.0.1:27017/dikori
JWT_SECRET=change_me_jwt_secret
CLIENT_ORIGINS=http://localhost:5173
ENFORCE_HTTPS=true

# reCAPTCHA
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_TEST_BYPASS=0

# Mobile human-proof fallback (guest checkout)
HUMAN_PROOF_SECRET=change_me_human_proof_secret
HUMAN_PROOF_DIFFICULTY=3
HUMAN_PROOF_CHALLENGE_TTL_MS=120000
HUMAN_PROOF_MAX_NONCE=250000

# Lahza / payments
LAHZA_SECRET_KEY=
PAY_CURRENCY=ILS
PAYMENT_MINOR_TOLERANCE=1
PAYMENT_TOKEN_SECRET=change_me_payment_token_secret
PAYMENT_TOKEN_TTL=900
WEBHOOK_IP_WHITELIST=true
WEBHOOK_ALLOWED_IPS=161.35.20.140,165.227.134.20

# Auth / reset password
RESET_PASSWORD_MAX_ATTEMPTS=5

# SMS (set what your provider needs)
SEND_SMS_ENABLED=0
DEV_ECHO_SMS=0
DEV_ECHO_OTP=0
SMS_BASE=
SMS_USER=
SMS_USERNAME=
SMS_PASS=
SMS_PASSWORD=
SMS_ID=
SMS_SENDER=
SMS_RECIPIENT_FORMAT=
SMS_HTD_BASE=
SMS_HTD_ID=
SMS_HTD_PASS=
SMS_HTD_PASSWORD=
SMS_HTD_SENDER=
SMS_HTD_API_STYLE=legacy

# Contact email
CONTACT_FROM=
CONTACT_TO=

# Order alert email
ORDER_ALERT_DISABLE=0
ORDER_ALERT_FROM=
ORDER_ALERT_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
